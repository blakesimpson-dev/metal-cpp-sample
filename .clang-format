---
BasedOnStyle: Google

DerivePointerAlignment: false
PointerAlignment: Left
QualifierAlignment: Left

IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[A-Za-z0-9_/]+\.h>$'
    Priority: 1
  - Regex: "^<[A-Za-z0-9_]+>$"
    Priority: 2
  - Regex: "^<"
    Priority: 3
  - Regex: '^"'
    Priority: 4

RawStringFormats:
  - Language: TextProto
    Delimiters:
      - "pb"
      - "proto"
    BasedOnStyle: Google

CommentPragmas: "(@copydoc|@copybrief|@see|@overload|@snippet)"
ColumnLimit: 80
